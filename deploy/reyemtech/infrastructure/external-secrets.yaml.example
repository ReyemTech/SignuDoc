apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: signudoc-env
  namespace: signudoc
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: signudoc-env
    creationPolicy: Owner
  data:
    - secretKey: BETTER_AUTH_SECRET
      remoteRef:
        key: replace-with-signudoc-app-vault-path
        property: BETTER_AUTH_SECRET
    - secretKey: CRON_SECRET
      remoteRef:
        key: replace-with-signudoc-app-vault-path
        property: CRON_SECRET
    - secretKey: SETUP_TOKEN
      remoteRef:
        key: replace-with-signudoc-app-vault-path
        property: SETUP_TOKEN
    - secretKey: RESEND_API_KEY
      remoteRef:
        key: replace-with-signudoc-app-vault-path
        property: RESEND_API_KEY
    - secretKey: AWS_ACCESS_KEY_ID
      remoteRef:
        key: replace-with-signudoc-app-vault-path
        property: AWS_ACCESS_KEY_ID
    - secretKey: AWS_SECRET_ACCESS_KEY
      remoteRef:
        key: replace-with-signudoc-app-vault-path
        property: AWS_SECRET_ACCESS_KEY
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: signudoc-db-backup
  namespace: signudoc
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: signudoc-db-backup
    creationPolicy: Owner
  data:
    - secretKey: ACCESS_KEY_ID
      remoteRef:
        key: replace-with-signudoc-backup-vault-path
        property: ACCESS_KEY_ID
    - secretKey: SECRET_ACCESS_KEY
      remoteRef:
        key: replace-with-signudoc-backup-vault-path
        property: SECRET_ACCESS_KEY
    - secretKey: REGION
      remoteRef:
        key: replace-with-signudoc-backup-vault-path
        property: REGION
