apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: signudoc-db
  namespace: signudoc
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
spec:
  instances: 3
  imageName: ghcr.io/cloudnative-pg/postgresql:17.12-202611122305-system-trixie@sha256:6b8f23131e02fb4f2765fd1c7f9bca1c09a0b8b5aa90d69a3c5e8e5c60fa3d76
  enableSuperuserAccess: false
  enablePDB: true
  affinity:
    enablePodAntiAffinity: true
    podAntiAffinityType: required
    topologyKey: kubernetes.io/hostname
  bootstrap:
    initdb:
      database: signudoc
      owner: signudoc
  postgresql:
    synchronous:
      method: any
      number: 1
      dataDurability: required
      failoverQuorum: true
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 2Gi
  storage:
    storageClass: ssd
    size: 20Gi
  backup:
    retentionPolicy: 30d
    target: prefer-standby
    # Legacy CNPG 1.30 integration. Plan migration to the Barman Cloud Plugin.
    barmanObjectStore:
      destinationPath: s3://replace-with-us-db-backup-bucket/signudoc
      endpointURL: https://backup-s3.example.com
      s3Credentials:
        accessKeyId:
          name: signudoc-db-backup
          key: ACCESS_KEY_ID
        secretAccessKey:
          name: signudoc-db-backup
          key: SECRET_ACCESS_KEY
        region:
          name: signudoc-db-backup
          key: REGION
      data:
        compression: gzip
      wal:
        compression: gzip
